# Generates a C++ source file that embeds binary files as byte arrays.
# Usage: cmake -DOUT=<file.cpp> -DFILES=<f1;f2> -DNAMES=<n1;n2> -P EmbedFiles.cmake
# The generated file defines hr::embedded::find(name) (declared in core/Embedded.hpp).

list(LENGTH FILES file_count)
list(LENGTH NAMES name_count)
if(NOT file_count EQUAL name_count)
    message(FATAL_ERROR "EmbedFiles: FILES and NAMES must have the same length")
endif()

set(body "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n")
string(APPEND body "#include \"core/Embedded.hpp\"\n#include <cstring>\n\nnamespace {\n")

set(table "")
math(EXPR last "${file_count} - 1")
foreach(i RANGE ${last})
    list(GET FILES ${i} path)
    list(GET NAMES ${i} name)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Break the byte list into lines of 32 values to keep the file readable for compilers/tools.
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n    " bytes "${bytes}")
    string(APPEND body "const unsigned char data_${name}[] = {\n    ${bytes}\n};\n")
    string(APPEND table "    {\"${name}\", data_${name}, ${size}},\n")
endforeach()

string(APPEND body "\nconst hr::embedded::Blob kBlobs[] = {\n${table}};\n\n} // namespace\n\n")
string(APPEND body "namespace hr::embedded {\n\n")
string(APPEND body "const Blob* find(const char* name)\n{\n")
string(APPEND body "    for (const Blob& blob : kBlobs) {\n")
string(APPEND body "        if (std::strcmp(blob.name, name) == 0) return &blob;\n    }\n    return nullptr;\n}\n\n")
string(APPEND body "} // namespace hr::embedded\n")

# Only touch the output when it changed, so unchanged assets don't trigger rebuilds.
if(EXISTS "${OUT}")
    file(READ "${OUT}" previous)
    if(previous STREQUAL body)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${body}")
